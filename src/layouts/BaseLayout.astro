---
import '../styles/global.css';
import { LANGUAGES, EN_TO_ES_ROUTES, ES_TO_EN_ROUTES, SPANISH_PAGE_PATHS } from '../i18n/config';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  lang?: 'en' | 'es';
}

const siteUrl = "https://fixmyimage.app";
const currentLang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const rawPath = Astro.url.pathname || '/';
const currentPath = rawPath.endsWith('/') && rawPath.length > 1 ? rawPath.slice(0, -1) : rawPath;

const defaultDesc = currentLang === 'es'
  ? "Herramientas gratuitas en línea para comprimir, redimensionar, convertir y marcar imágenes directamente en tu navegador. Rápido, privado y sin subidas a servidores."
  : "Free online tools to compress, resize, convert and watermark images directly in your browser. Fast, private, no uploads.";

const {
  title,
  description = defaultDesc,
  canonical,
  ogImage = "/web-app-manifest-512x512.png",
  noindex = false,
} = Astro.props;

const canonicalUrl = canonical ?? (siteUrl + (currentPath === '/' ? '' : currentPath));
const finalCanonical = canonicalUrl || siteUrl;

// Reciprocal hreflang calculation
let enUrl: string | null = null;
let esUrl: string | null = null;

if (currentLang === 'es') {
  esUrl = siteUrl + currentPath;
  const enRoute = ES_TO_EN_ROUTES[currentPath];
  if (enRoute) {
    enUrl = siteUrl + (enRoute === '/' ? '' : enRoute);
  }
} else {
  enUrl = siteUrl + (currentPath === '/' ? '' : currentPath);
  const esRoute = EN_TO_ES_ROUTES[currentPath];
  if (esRoute) {
    esUrl = siteUrl + esRoute;
  }
}

const xDefaultUrl = enUrl ?? (siteUrl + (currentPath === '/' ? '' : currentPath));
---

<!doctype html>
<html lang={currentLang} dir={LANGUAGES[currentLang].dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={finalCanonical} />
    {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {esUrl && <link rel="alternate" hreflang="es" href={esUrl} />}
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
    
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FixMyImage" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="FixMyImage" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "FixMyImage",
      "url": siteUrl,
      "description": currentLang === 'es' ? "Herramientas de imagen online gratuitas — comprime, redimensiona, convierte y añade marcas de agua en tu navegador." : "Free online image tools — compress, resize, convert and watermark images in your browser."
    })} />

    <meta name="generator" content={Astro.generator} />

    <!-- Theme: no FOUC -->
    <script is:inline>
      const saved = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (saved === 'dark' || (!saved && prefersDark)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-MN6TN3HL49"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-MN6TN3HL49');
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
