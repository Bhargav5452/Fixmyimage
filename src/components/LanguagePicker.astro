---
import { LANGUAGES, DEFAULT_LOCALE } from '../i18n/config';
import { getLangFromUrl, getRelativeLocaleUrl } from '../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const currentPath = Astro.url.pathname.replace(LANGUAGES[currentLang].prefix, '') || '/';
const hasMultipleLanguages = Object.keys(LANGUAGES).length > 1;
---

{hasMultipleLanguages && (
  <div class="relative group" aria-label="Language switcher">
    <button type="button" class="flex items-center gap-2 px-3 py-1.5 text-[13px] font-medium text-body hover:text-ink hover:bg-hairline-soft rounded-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/><path d="M2 12h20"/></svg>
      {LANGUAGES[currentLang].nativeName}
    </button>
    <div class="absolute right-0 mt-2 w-48 bg-canvas-elevated border border-hairline rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50 py-2">
      {Object.entries(LANGUAGES).map(([code, config]) => (
        <a 
          href={getRelativeLocaleUrl(code as keyof typeof LANGUAGES, currentPath)}
          class={`block px-4 py-2 text-[14px] hover:bg-hairline-soft ${currentLang === code ? 'font-bold text-ink' : 'text-body hover:text-ink'}`}
        >
          {config.nativeName}
        </a>
      ))}
    </div>
  </div>
)}
