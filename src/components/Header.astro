---
import { getLangFromUrl, getRelativeLocaleUrl, useTranslations } from '../i18n/utils';
import LanguagePicker from './LanguagePicker.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<header class="w-full bg-canvas border-b border-hairline sticky top-0 z-40">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-[72px] flex items-center justify-between gap-4">

    <!-- Wordmark -->
    <a href={getRelativeLocaleUrl(lang, '/')} class="flex items-center gap-3 shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm" aria-label={t('nav.home') + ' — home'}>
      <img src="/logo1.png" alt="" class="w-9 h-9 dark:hidden block" aria-hidden="true" />
      <img src="/logo2.png" alt="" class="w-9 h-9 hidden dark:block" aria-hidden="true" />
      <span class="text-[20px] font-semibold tracking-tight text-ink">{t('nav.home')}</span>
    </a>

    <!-- Nav -->
    <nav class="flex items-center gap-2" aria-label="Main navigation">
      <a href={getRelativeLocaleUrl(lang, 'compress-image')} class="hidden sm:inline-flex items-center px-4 py-2 text-[17px] font-medium text-body hover:text-ink hover:bg-hairline-soft rounded-sm transition-colors">{t('nav.compress')}</a>
      <a href={getRelativeLocaleUrl(lang, 'resize-image')} class="hidden sm:inline-flex items-center px-4 py-2 text-[17px] font-medium text-body hover:text-ink hover:bg-hairline-soft rounded-sm transition-colors">{t('nav.resize')}</a>
      <a href={getRelativeLocaleUrl(lang, 'convert-image')} class="hidden sm:inline-flex items-center px-4 py-2 text-[17px] font-medium text-body hover:text-ink hover:bg-hairline-soft rounded-sm transition-colors">{t('nav.convert')}</a>
      <a href={getRelativeLocaleUrl(lang, 'watermark-image')} class="hidden sm:inline-flex items-center px-4 py-2 text-[17px] font-medium text-body hover:text-ink hover:bg-hairline-soft rounded-sm transition-colors">{t('nav.watermark')}</a>

      <div class="w-px h-5 bg-hairline mx-2 hidden sm:block" aria-hidden="true"></div>

      <LanguagePicker />

      <!-- Theme toggle -->
      <button
        type="button"
        id="theme-toggle"
        class="flex items-center justify-center w-10 h-10 text-body hover:text-ink hover:bg-hairline-soft rounded-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        aria-label="Toggle dark mode"
      >
        <!-- Sun (shown in dark mode) -->
        <svg id="theme-icon-light" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <!-- Moon (shown in light mode) -->
        <svg id="theme-icon-dark" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
      </button>

      <!-- Mobile: tools menu -->
      <button type="button" id="mobile-menu-toggle" class="sm:hidden flex items-center justify-center w-10 h-10 text-body hover:text-ink hover:bg-hairline-soft rounded-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" aria-label="Toggle menu" aria-expanded="false">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="menu-icon">
          <line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="18" y2="18"/>
        </svg>
      </button>
    </nav>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden sm:hidden border-t border-hairline bg-canvas">
    <div class="flex flex-col px-4 py-3 gap-1 shadow-inner shadow-black/5 dark:shadow-none">
      <a href={getRelativeLocaleUrl(lang, 'compress-image')} class="block px-3 py-3 text-[16px] font-medium text-body hover:text-ink hover:bg-hairline-soft rounded-lg transition-colors">{t('nav.compress')}</a>
      <a href={getRelativeLocaleUrl(lang, 'resize-image')} class="block px-3 py-3 text-[16px] font-medium text-body hover:text-ink hover:bg-hairline-soft rounded-lg transition-colors">{t('nav.resize')}</a>
      <a href={getRelativeLocaleUrl(lang, 'convert-image')} class="block px-3 py-3 text-[16px] font-medium text-body hover:text-ink hover:bg-hairline-soft rounded-lg transition-colors">{t('nav.convert')}</a>
      <a href={getRelativeLocaleUrl(lang, 'watermark-image')} class="block px-3 py-3 text-[16px] font-medium text-body hover:text-ink hover:bg-hairline-soft rounded-lg transition-colors">{t('nav.watermark')}</a>
    </div>
  </div>
</header>

<script>
  const html = document.documentElement;

  const iconLight = document.getElementById('theme-icon-light')!;
  const iconDark  = document.getElementById('theme-icon-dark')!;

  function syncIcons() {
    const isDark = html.classList.contains('dark');
    iconLight?.classList.toggle('hidden', !isDark);
    iconDark?.classList.toggle('hidden', isDark);
  }

  syncIcons();

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    html.classList.toggle('dark');
    const isDark = html.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    syncIcons();
  });

  const menuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  menuToggle?.addEventListener('click', () => {
    const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
    menuToggle.setAttribute('aria-expanded', (!isExpanded).toString());
    mobileMenu?.classList.toggle('hidden');
  });
</script>
