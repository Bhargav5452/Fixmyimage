---
/**
 * SeoContent.astro
 * ─────────────────────────────────────────────────────────────────
 * Isolated SEO supporting content section.
 * Placed in document flow AFTER the tool workspace and BEFORE <Footer />.
 *
 * CSS is strictly scoped to this component via Astro scoped styles.
 * Uses existing CSS tokens (--color-ink, --color-body, etc.) to
 * guarantee seamless dark mode and typography alignment.
 */

import { getLangFromUrl } from '../i18n/utils';

interface Faq {
  q: string;
  a: string;
}

interface RelatedLink {
  label: string;
  href: string;
}

interface Section {
  title: string;
  paragraphs: string[];
}

interface Props {
  heading?: string;
  paragraphs?: string[];
  sections?: Section[];
  faqs?: Faq[];
  faqHeading?: string;
  relatedHeading?: string;
  relatedLinks?: RelatedLink[];
  faqJsonLd?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const isEs = lang === 'es';

const {
  heading,
  paragraphs = [],
  sections = [],
  faqs = [],
  faqHeading = isEs ? 'Preguntas Frecuentes' : 'Frequently Asked Questions',
  relatedHeading = isEs ? 'Herramientas Relacionadas' : 'Related Tools',
  relatedLinks = [],
  faqJsonLd = true,
} = Astro.props;

const jsonLd = faqJsonLd && faqs.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  : null;
---

{jsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}

<section class="seo-content" aria-label={isEs ? 'Información adicional' : 'Supporting Information'}>
  <div class="seo-content__inner">

    {heading && <h2 class="seo-content__h2">{heading}</h2>}

    {paragraphs.map(p => <p class="seo-content__p" set:html={p} />)}

    {sections.map(s => (
      <div class="seo-content__section">
        <h3 class="seo-content__h3">{s.title}</h3>
        {s.paragraphs.map(p => <p class="seo-content__p" set:html={p} />)}
      </div>
    ))}

    {faqs.length > 0 && (
      <div class="seo-content__faq">
        <h2 class="seo-content__h2">{faqHeading}</h2>
        {faqs.map(f => (
          <div class="seo-content__faq-item">
            <h3 class="seo-content__faq-q">{f.q}</h3>
            <p class="seo-content__faq-a">{f.a}</p>
          </div>
        ))}
      </div>
    )}

    {relatedLinks.length > 0 && (
      <div class="seo-content__related">
        <h2 class="seo-content__h2">{relatedHeading}</h2>
        <div class="seo-content__links">
          {relatedLinks.map(l => (
            <a href={l.href.endsWith('/') || l.href.includes('#') ? l.href : `${l.href}/`} class="seo-content__link">{l.label}</a>
          ))}
        </div>
      </div>
    )}

  </div>
</section>

<style>
  .seo-content {
    width: 100%;
    border-top: 1px solid var(--color-hairline);
    background-color: var(--color-canvas);
    padding: 3.5rem 1rem 4rem;
  }

  @media (min-width: 640px) {
    .seo-content {
      padding: 4rem 1.5rem 4.5rem;
    }
  }

  .seo-content__inner {
    max-width: 48rem;
    margin: 0 auto;
  }

  .seo-content__h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-ink);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .seo-content__inner > .seo-content__h2:first-child {
    margin-top: 0;
  }

  .seo-content__h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }

  .seo-content__p {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-body);
    margin-bottom: 0.875rem;
  }

  .seo-content__section {
    margin-top: 1.25rem;
  }

  .seo-content__faq {
    margin-top: 2.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-hairline);
  }

  .seo-content__faq-item {
    margin-top: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-hairline-soft);
  }

  .seo-content__faq-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .seo-content__faq-q {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 0.375rem;
    line-height: 1.4;
  }

  .seo-content__faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-body);
    margin-bottom: 0;
  }

  .seo-content__related {
    margin-top: 2.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-hairline);
  }

  .seo-content__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .seo-content__link {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-body);
    background-color: var(--color-canvas-elevated);
    border: 1px solid var(--color-hairline);
    border-radius: 9999px;
    text-decoration: none;
    transition: all 150ms ease;
  }

  .seo-content__link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background-color: var(--color-canvas);
  }
</style>
