---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConvertDropzone from '../components/ConvertDropzone.astro';
import SeoContent from '../components/SeoContent.astro';
import { getFaqsForRoute } from '../data/curatedFaqs';

const title = "AVIF to PNG Converter – Convert AVIF to PNG Online Free | FixMyImage";
const desc = "Convert AVIF images to PNG format online for free. Maintain lossless quality and alpha transparency directly in your browser.";
const canonicalUrl = "https://fixmyimage.app/avif-to-png";

const faqs = getFaqsForRoute('/avif-to-png');

const relatedLinks = [
  { label: "AVIF to JPG", href: "/avif-to-jpg" },
  { label: "WebP to PNG", href: "/webp-to-png" },
  { label: "JPG to PNG", href: "/jpg-to-png" },
  { label: "PNG to JPG", href: "/png-to-jpg" },
  { label: "Image Resizer", href: "/resize-image" }
];
---

<BaseLayout title={title} description={desc} canonical={canonicalUrl}>
  <Header />
  <main class="flex-grow flex flex-col items-center justify-start px-4 pt-[15vh] md:pt-[20vh] pb-12 md:pb-16 bg-canvas min-h-[calc(100vh-72px)]">
    <div class="w-full max-w-4xl mx-auto">
      <ConvertDropzone 
        h1="Convert AVIF to PNG"
        subtitle="Convert AVIF images to PNG format online for free."
        initialInputFormat="avif"
        initialOutputFormat="png"
      />
    </div>
  </main>

  <SeoContent
    heading="Lossless AVIF to PNG Conversion"
    paragraphs={[
      "Convert next-generation AVIF images into universally compatible, lossless PNG files with FixMyImage's dedicated <a href='/convert-image/' class='text-accent hover:underline'>image converter</a>. When working with graphic design software or importing assets into presentation tools that do not recognize `.avif` files, converting to PNG is the ideal solution. If you don't need transparency, converting <a href='/avif-to-jpg/' class='text-accent hover:underline'>AVIF to JPG</a> can save more space.",
      "The tool operates entirely client-side, preserving full transparency and fine color gradients without sending your pictures across the internet. You can use this same secure engine to convert other modern formats like <a href='/webp-to-png/' class='text-accent hover:underline'>WebP to PNG</a> for all your visual assets."
    ]}
    faqs={faqs}
    relatedHeading="Related Image Converters"
    relatedLinks={relatedLinks}
  />

  <Footer />
</BaseLayout>
