---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, getRelativeLocaleUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={t('metadata.page_404_title')} description={t('metadata.page_404_desc')}>
  <Header />
  
  <main class="flex-grow flex flex-col items-center justify-center px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center max-w-md w-full">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-canvas-elevated border border-hairline mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-ink opacity-50"><circle cx="12" cy="12" r="10"/><path d="M16 16s-1.5-2-4-2-4 2-4 2"/><line x1="9" x2="9.01" y1="9" y2="9"/><line x1="15" x2="15.01" y1="9" y2="9"/></svg>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold text-ink mb-4">Page not found.</h1>
      <p class="text-[16px] text-body mb-8">
        We can't seem to find the page you're looking for.
      </p>
      
      <div class="bg-canvas-elevated border border-hairline rounded-lg p-6 text-left">
        <h2 class="text-[14px] font-semibold text-ink uppercase tracking-wider mb-4">Try one of our tools:</h2>
        <nav class="flex flex-col gap-3">
          <a href={getRelativeLocaleUrl(lang, '/')} class="text-body hover:text-ink hover:underline flex items-center gap-2 transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-home"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg> {t('nav.home')}</a>
          <a href={getRelativeLocaleUrl(lang, 'compress-image')} class="text-body hover:text-ink hover:underline flex items-center gap-2 transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-minimize"><path d="M8 3v3a2 2 0 0 1-2 2H3"/><path d="M21 8h-3a2 2 0 0 1-2-2V3"/><path d="M3 16h3a2 2 0 0 1 2 2v3"/><path d="M16 21v-3a2 2 0 0 1 2-2h3"/></svg> {t('nav.compress')}</a>
          <a href={getRelativeLocaleUrl(lang, 'resize-image')} class="text-body hover:text-ink hover:underline flex items-center gap-2 transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-scaling"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M14 15H9v-5"/><path d="M16 3h5v5"/><path d="M21 3l-6 6"/></svg> {t('nav.resize')}</a>
          <a href={getRelativeLocaleUrl(lang, 'convert-image')} class="text-body hover:text-ink hover:underline flex items-center gap-2 transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left-right"><path d="M8 3 4 7l4 4"/><path d="M4 7h16"/><path d="m16 21 4-4-4-4"/><path d="M20 17H4"/></svg> {t('nav.convert')}</a>
          <a href={getRelativeLocaleUrl(lang, 'watermark-image')} class="text-body hover:text-ink hover:underline flex items-center gap-2 transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copyright"><circle cx="12" cy="12" r="10"/><path d="M14.83 14.83a4 4 0 1 1 0-5.66"/></svg> {t('nav.watermark')}</a>
        </nav>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
