---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import UploadDropzone from '../components/UploadDropzone.astro';
import SeoContent from '../components/SeoContent.astro';
import { getSpanishFaqsForRoute } from '../data/spanishFaqs';

const title = "Comprimir imagen a 100 KB online gratis | FixMyImage";
const description = "Reduce el tamaño de tus imágenes a 100 KB online gratis. Ajuste exacto para firmas, envíos por correo y documentos digitales en JPG, PNG y WebP.";
const canonicalUrl = "https://fixmyimage.app/comprimir-imagen-a-100-kb";

const faqs = getSpanishFaqsForRoute('/comprimir-imagen-a-100-kb');

const relatedLinks = [
  { label: "Comprimir imagen", href: "/comprimir-imagen" },
  { label: "Comprimir imagen a 50 KB", href: "/comprimir-imagen-a-50-kb" },
  { label: "Comprimir imagen a 1 MB", href: "/comprimir-imagen-a-1-mb" },
  { label: "Redimensionar imagen", href: "/redimensionar-imagen" },
  { label: "Convertir imágenes", href: "/convertir-imagen" }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  lang="es"
>
  <Header />

  <main class="flex-grow flex flex-col items-center justify-start px-4 pt-8 md:pt-12 pb-12 md:pb-16 bg-canvas min-h-[calc(100vh-72px)]">
    <div class="w-full max-w-[960px] mx-auto">
      <UploadDropzone
        h1="Comprimir imagen a 100 KB online"
        subtitle="Optimiza fotos e imágenes para situarlas por debajo de 100 KB. El tamaño estándar para currículums, correos y formularios."
        presetValue="100"
        presetUnit="KB"
      />
    </div>
  </main>

  <SeoContent
    heading="Optimización de imágenes a 100 KB sin pérdidas perceptibles"
    paragraphs={[
      "El límite de 100 KB es ampliamente utilizado en plataformas digitales, currículums vitae y sistemas de registro para evitar archivos pesados. Con FixMyImage puedes comprimir imágenes JPG, PNG y WebP para que alcancen el tamaño óptimo de 100 KB manteniendo los colores vivos y la claridad necesaria.",
      "Nuestra herramienta realiza todos los cálculos de compresión en el cliente, preservando la confidencialidad de tus fotos y permitiendo descargas instantáneas sin colas de espera ni marcas de agua."
    ]}
    faqs={faqs}
    faqHeading="Preguntas frecuentes sobre comprimir a 100 KB"
    relatedHeading="Otras opciones de compresión"
    relatedLinks={relatedLinks}
  />

  <Footer />
</BaseLayout>
