---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WatermarkDropzone from '../components/WatermarkDropzone.astro';
import SeoContent from '../components/SeoContent.astro';
import { getSpanishFaqsForRoute } from '../data/spanishFaqs';

const title = "Poner marca de agua a fotos online gratis – Añadir texto o logo | FixMyImage";
const description = "Añade marcas de agua a tus fotos e imágenes online gratis. Inserta tu logo o texto personalizado con control de opacidad, tamaño y posición.";
const canonicalUrl = "https://fixmyimage.app/marca-de-agua";

const faqs = getSpanishFaqsForRoute('/marca-de-agua');

const relatedLinks = [
  { label: "Comprimir imagen", href: "/comprimir-imagen" },
  { label: "Redimensionar imagen", href: "/redimensionar-imagen" },
  { label: "Convertir imágenes", href: "/convertir-imagen" },
  { label: "Redimensionar por lotes", href: "/redimensionar-imagenes-por-lotes" }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  lang="es"
>
  <Header />

  <main class="flex-grow flex flex-col items-center justify-start px-4 pt-8 md:pt-12 pb-12 md:pb-16 bg-canvas min-h-[calc(100vh-72px)]">
    <div class="w-full max-w-[960px] mx-auto">
      <WatermarkDropzone
        h1="Poner marca de agua a imágenes"
        subtitle="Añade un logotipo o texto a tus fotos para proteger tu autoría. Ajusta posición, opacidad y rotación con facilidad."
      />
    </div>
  </main>

  <SeoContent
    heading="Protege tus fotografías añadiendo una marca de agua personalizada"
    paragraphs={[
      "Poner una marca de agua a tus fotos es la forma más efectiva de proteger tus creaciones visuales antes de publicarlas en redes sociales, blogs o tiendas online. FixMyImage te permite añadir tu texto de autoría o estampar el logotipo de tu marca de forma sencilla y precisa.",
      "Personaliza la opacidad para un acabado sutil y no invasivo, selecciona la ubicación exacta en la cuadrícula de nueve posiciones y ajusta el tamaño en porcentaje. Gracias al procesamiento en el cliente, tus fotos y logotipos nunca se suben a internet."
    ]}
    faqs={faqs}
    faqHeading="Preguntas frecuentes sobre poner marcas de agua"
    relatedHeading="Otras herramientas de optimización"
    relatedLinks={relatedLinks}
  />

  <Footer />
</BaseLayout>
