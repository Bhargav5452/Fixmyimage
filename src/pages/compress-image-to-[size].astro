---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import UploadDropzone from '../components/UploadDropzone.astro';
import SeoContent from '../components/SeoContent.astro';
import { getFaqsForRoute } from '../data/curatedFaqs';

export async function getStaticPaths() {
  const targets = [
    { size: '10kb', value: '10', unit: 'KB' },
    { size: '20kb', value: '20', unit: 'KB' },
    { size: '30kb', value: '30', unit: 'KB' },
    { size: '40kb', value: '40', unit: 'KB' },
    { size: '50kb', value: '50', unit: 'KB' },
    { size: '100kb', value: '100', unit: 'KB' },
    { size: '200kb', value: '200', unit: 'KB' },
    { size: '500kb', value: '500', unit: 'KB' },
    { size: '1mb', value: '1', unit: 'MB' },
  ];
  return targets.map(t => ({
    params: { size: t.size },
    props: { target: t }
  }));
}

const { target } = Astro.props;
const displaySize = target.unit === 'MB' ? `${target.value}MB` : `${target.value}KB`;
const canonicalUrl = `https://fixmyimage.app/compress-image-to-${target.size}`;
const faqs = getFaqsForRoute(`/compress-image-to-${target.size}`);

const ALL_SIZES = [
  { size: '10kb', label: 'Compress to 10KB', href: '/compress-image-to-10kb' },
  { size: '20kb', label: 'Compress to 20KB', href: '/compress-image-to-20kb' },
  { size: '30kb', label: 'Compress to 30KB', href: '/compress-image-to-30kb' },
  { size: '40kb', label: 'Compress to 40KB', href: '/compress-image-to-40kb' },
  { size: '50kb', label: 'Compress to 50KB', href: '/compress-image-to-50kb' },
  { size: '100kb', label: 'Compress to 100KB', href: '/compress-image-to-100kb' },
  { size: '200kb', label: 'Compress to 200KB', href: '/compress-image-to-200kb' },
  { size: '500kb', label: 'Compress to 500KB', href: '/compress-image-to-500kb' },
  { size: '1mb', label: 'Compress to 1MB', href: '/compress-image-to-1mb' },
];

const relatedLinks = ALL_SIZES.filter(s => s.size !== target.size);

interface SizeContent {
  title: string;
  desc: string;
  h1: string;
  subtitle: string;
  heading: string;
  paragraphs: string[];
}

const SIZE_DATA: Record<string, SizeContent> = {
  '10kb': {
    title: 'Compress Image to 10KB Online Free | FixMyImage',
    desc: 'Compress JPG, PNG and WebP images to under 10KB online for free. Ideal for strict government forms, signature uploads, and document portals.',
    h1: 'Compress Image to 10KB',
    subtitle: 'Compress JPG, PNG and WebP images to under 10KB online.',
    heading: 'How to Compress Images to Under 10KB',
    paragraphs: [
      'Many online government portals, recruitment boards, and examination registration websites enforce strict file limits of 10KB or less for digital signatures and thumb impressions. Achieving a file size this compact requires an effective combination of quality optimization and dimension adjustments using our dedicated <a href="/compress-image/" class="text-accent hover:underline">image compressor</a>.',
      'FixMyImage runs modern browser-based compression directly on your device. When aiming for 10KB, reducing the image resolution slightly alongside balanced lossy compression allows you to meet the threshold cleanly. If 10KB is too strict, you can easily <a href="/compress-image-to-20kb/" class="text-accent hover:underline">compress to 20KB</a> or <a href="/compress-image-to-30kb/" class="text-accent hover:underline">30KB</a> instead.'
    ]
  },
  '20kb': {
    title: 'Compress Image to 20KB Online Free | FixMyImage',
    desc: 'Compress JPG, PNG and WebP images to 20KB online for free. Perfect for exam admit cards, job application portals, and identity documents.',
    h1: 'Compress Image to 20KB',
    subtitle: 'Compress JPG, PNG and WebP images to 20KB online.',
    heading: 'Online Image Compression to 20KB',
    paragraphs: [
      'A 20KB limit is one of the most common specifications for passport photos, exam admit cards, and job recruitment forms across government and educational institutions. Meeting this limit requires minimizing file metadata while retaining clear facial features, which is exactly what our <a href="/compress-image/" class="text-accent hover:underline">image compressor</a> is designed for.',
      'With FixMyImage, your images are compressed instantly in your browser without uploading to external servers. For stricter portal requirements, you can <a href="/compress-image-to-10kb/" class="text-accent hover:underline">compress to 10KB</a>, or for slightly higher quality, try our <a href="/compress-image-to-30kb/" class="text-accent hover:underline">compress to 30KB</a> and <a href="/compress-image-to-40kb/" class="text-accent hover:underline">40KB tools</a>.'
    ]
  },
  '30kb': {
    title: 'Compress Image to 30KB Online Free | FixMyImage',
    desc: 'Compress JPG, PNG and WebP images to 30KB online for free. Ideal for national exam forms, student registrations, and portal uploads.',
    h1: 'Compress Image to 30KB',
    subtitle: 'Compress JPG, PNG and WebP images to 30KB online.',
    heading: 'Compressing Images to 30KB for Online Applications',
    paragraphs: [
      'Application forms often designate 30KB as the ceiling for candidate photographs and academic certificate scans. This target gives slightly more leeway than smaller sizes, making it easier to preserve authentic skin tones and clear text using our powerful <a href="/compress-image/" class="text-accent hover:underline">image compressor</a>.',
      'FixMyImage allows you to batch compress multiple images to 30KB in seconds. If your portal rejects the file, you can downsize further by choosing to <a href="/compress-image-to-20kb/" class="text-accent hover:underline">compress to 20KB</a>. Alternatively, if the limit is more generous, <a href="/compress-image-to-50kb/" class="text-accent hover:underline">compress to 50KB</a> will yield better visual quality.'
    ]
  },
  '40kb': {
    title: 'Compress Image to 40KB Online Free | FixMyImage',
    desc: 'Compress JPG, PNG and WebP images to 40KB online for free. Fast, browser-based compression with no signup required.',
    h1: 'Compress Image to 40KB',
    subtitle: 'Compress JPG, PNG and WebP images to 40KB online.',
    heading: 'Quick Image Compression to 40KB',
    paragraphs: [
      'Several competitive exam portals and banking application systems specify an image size bracket between 20KB and 40KB. Hitting this target ensures your document is accepted without failing automated portal validation checks when using our <a href="/compress-image/" class="text-accent hover:underline">image compressor</a>.',
      'Our in-browser compressor adjusts compression parameters to hit the 40KB target cleanly. If you need it slightly smaller, try to <a href="/compress-image-to-30kb/" class="text-accent hover:underline">compress to 30KB</a>, or scale up to <a href="/compress-image-to-50kb/" class="text-accent hover:underline">compress to 50KB</a> for standard web avatars.'
    ]
  },
  '50kb': {
    title: 'Compress Image to 50KB Online Free | FixMyImage',
    desc: 'Compress JPG, PNG and WebP images to 50KB online for free. Reduce image file size directly in your browser with no account required.',
    h1: 'Compress Image to 50KB',
    subtitle: 'Compress JPG, PNG and WebP images to 50KB online.',
    heading: 'Compress Images to 50KB Online',
    paragraphs: [
      'The 50KB target is a widely recognized standard for visa applications, passport photo uploads, state civil service portals, and professional profile avatars. It offers a solid balance between crisp visual detail and lightweight web performance, optimized perfectly by our <a href="/compress-image/" class="text-accent hover:underline">image compressor</a>.',
      'Because processing is executed client-side, your personal documents stay completely private. If you are preparing digital media rather than forms, you might want to <a href="/compress-image-to-100kb/" class="text-accent hover:underline">compress to 100KB</a> or <a href="/compress-image-to-200kb/" class="text-accent hover:underline">200KB</a> for higher fidelity, or drop down to <a href="/compress-image-to-30kb/" class="text-accent hover:underline">30KB</a> if the portal is very strict.'
    ]
  },
  '100kb': {
    title: 'Compress Image to 100KB Online Free | FixMyImage',
    desc: 'Compress JPG, PNG and WebP images to 100KB online for free. Perfect for email attachments, web publishing, and resume photos.',
    h1: 'Compress Image to 100KB',
    subtitle: 'Compress JPG, PNG and WebP images to 100KB online.',
    heading: 'Compressing Images to 100KB',
    paragraphs: [
      'A file size of 100KB is the sweet spot for modern digital media, including email newsletters, blog article illustrations, resume attachments, and portfolio galleries. It delivers crisp high-definition visuals on retina screens while keeping page loading times fast when processed through our <a href="/compress-image/" class="text-accent hover:underline">image compressor</a>.',
      'FixMyImage lets you compress single images or bulk batches to 100KB right inside your browser. For smaller avatars you can <a href="/compress-image-to-50kb/" class="text-accent hover:underline">compress to 50KB</a>, or for larger hero graphics, <a href="/compress-image-to-200kb/" class="text-accent hover:underline">compress to 200KB</a> or <a href="/compress-image-to-500kb/" class="text-accent hover:underline">500KB</a>.'
    ]
  },
  '200kb': {
    title: 'Compress Image to 200KB Online Free | FixMyImage',
    desc: 'Compress JPG, PNG and WebP images to 200KB online for free. Ideal for e-commerce stores, social media headers, and blog graphics.',
    h1: 'Compress Image to 200KB',
    subtitle: 'Compress JPG, PNG and WebP images to 200KB online.',
    heading: 'Optimize Images to Under 200KB',
    paragraphs: [
      'E-commerce product catalogs, blog hero banners, and digital marketing creatives frequently require files under 200KB. This allows large-dimension images to display with rich colors and sharp focus without slowing down product catalog browsing. Our <a href="/compress-image/" class="text-accent hover:underline">image compressor</a> is built exactly for this purpose.',
      'FixMyImage processes your photos directly in memory. You can compress product photography effortlessly. For simpler graphics, <a href="/compress-image-to-100kb/" class="text-accent hover:underline">compress to 100KB</a> is often sufficient, while high-res gallery images might need our <a href="/compress-image-to-500kb/" class="text-accent hover:underline">compress to 500KB</a> or <a href="/compress-image-to-1mb/" class="text-accent hover:underline">1MB tools</a>.'
    ]
  },
  '500kb': {
    title: 'Compress Image to 500KB Online Free | FixMyImage',
    desc: 'Compress JPG, PNG and WebP images to 500KB online for free. Retain rich detail in high-resolution photos for web and print.',
    h1: 'Compress Image to 500KB',
    subtitle: 'Compress JPG, PNG and WebP images to 500KB online.',
    heading: 'Compressing High-Resolution Images to 500KB',
    paragraphs: [
      'Large photography showcases, real estate listings, and professional portfolio images often target 500KB. This threshold preserves fine grain, subtle lighting gradients, and crisp focus across high-density 4K displays while dramatically reducing the multi-megabyte footprint of raw camera captures using our <a href="/compress-image/" class="text-accent hover:underline">image compressor</a>.',
      'Using client-side processing pipelines, FixMyImage condenses heavy camera files to 500KB in seconds. For slightly smaller assets you can <a href="/compress-image-to-200kb/" class="text-accent hover:underline">compress to 200KB</a>, or for maximum quality retention on large files, try our <a href="/compress-image-to-1mb/" class="text-accent hover:underline">compress to 1MB</a> feature.'
    ]
  },
  '1mb': {
    title: 'Compress Image to 1MB Online Free | FixMyImage',
    desc: 'Compress JPG, PNG and WebP images to 1MB online for free. Quickly reduce multi-megabyte photos for email and web uploads.',
    h1: 'Compress Image to 1MB',
    subtitle: 'Compress JPG, PNG and WebP images to 1MB online.',
    heading: 'Compress Images to 1MB Online',
    paragraphs: [
      'Modern smartphone cameras and digital camera sensors capture images ranging from 5MB to over 20MB. Many email providers, messaging apps, and content management systems reject attachments exceeding 1MB. Compressing down to 1MB using our <a href="/compress-image/" class="text-accent hover:underline">image compressor</a> maintains near-lossless clarity while eliminating file transfer bottlenecks.',
      'FixMyImage provides instant in-browser compression to 1MB without registration. If 1MB is still too large for your platform, you can aggressively downsize and <a href="/compress-image-to-500kb/" class="text-accent hover:underline">compress to 500KB</a> or <a href="/compress-image-to-200kb/" class="text-accent hover:underline">200KB</a> for easier sharing.'
    ]
  }
};

const currentData = SIZE_DATA[target.size] || {
  title: `Compress Image to ${displaySize} Online – Free Image Compressor | FixMyImage`,
  desc: `Compress JPG, PNG and WebP images to ${displaySize} online for free.`,
  h1: `Compress Image to ${displaySize}`,
  subtitle: `Compress JPG, PNG and WebP images to ${displaySize} online.`,
  heading: `Compress Images to ${displaySize}`,
  paragraphs: [
    `Reduce your JPG, PNG, and WebP image file sizes to ${displaySize} quickly and safely in your browser.`
  ]
};
---

<BaseLayout title={currentData.title} description={currentData.desc} canonical={canonicalUrl}>
  <Header />

  <main class="flex-grow flex flex-col items-center justify-start px-4 pt-8 md:pt-12 pb-12 md:pb-16 bg-canvas min-h-[calc(100vh-72px)]">
    <div class="w-full max-w-[960px] mx-auto">
      <UploadDropzone h1={currentData.h1} subtitle={currentData.subtitle} presetValue={target.value} presetUnit={target.unit} />
    </div>
  </main>

  <SeoContent
    heading={currentData.heading}
    paragraphs={currentData.paragraphs}
    faqs={faqs}
    relatedHeading="Other Image Compression Sizes"
    relatedLinks={relatedLinks}
  />

  <Footer />
</BaseLayout>
