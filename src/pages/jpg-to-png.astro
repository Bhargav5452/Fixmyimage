---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConvertDropzone from '../components/ConvertDropzone.astro';
import SeoContent from '../components/SeoContent.astro';

import { getFaqsForRoute } from '../data/curatedFaqs';

const title = "JPG to PNG Converter – Convert JPG to PNG Online Free | FixMyImage";
const desc = "Convert JPG images to PNG format online for free. Transform JPEG files into high-quality PNGs with lossless clarity directly in your browser.";
const canonicalUrl = "https://fixmyimage.app/jpg-to-png";

const faqs = getFaqsForRoute('/jpg-to-png');

const relatedLinks = [
  { label: "PNG to JPG", href: "/png-to-jpg" },
  { label: "WebP to PNG", href: "/webp-to-png" },
  { label: "AVIF to PNG", href: "/avif-to-png" },
  { label: "WebP to JPG", href: "/webp-to-jpg" },
  { label: "Compress Image", href: "/compress-image" }
];
---

<BaseLayout title={title} description={desc} canonical={canonicalUrl}>
  <Header />
  <main class="flex-grow flex flex-col items-center justify-start px-4 pt-[15vh] md:pt-[20vh] pb-12 md:pb-16 bg-canvas min-h-[calc(100vh-72px)]">
    <div class="w-full max-w-[1150px] mx-auto">
      <ConvertDropzone 
        h1="Convert JPG to PNG"
        subtitle="Convert JPG images to PNG format online for free."
        initialInputFormat="jpeg"
        initialOutputFormat="png"
      />
    </div>
  </main>

  <SeoContent
    heading="Convert JPG to High-Quality PNG Format"
    paragraphs={[
      "Convert your JPEG images into PNG files quickly and securely with FixMyImage's dedicated <a href='/convert-image/' class='text-accent hover:underline'>image converter</a>. While JPEG is great for compact photography storage, PNG is preferred for digital graphics, screenshots, and artwork that require lossless fidelity and artifact-free edges. If you need to reverse the process later, you can easily switch back from <a href='/png-to-jpg/' class='text-accent hover:underline'>PNG to JPG</a>.",
      "Our in-browser engine handles the transformation directly on your machine. No uploads, no waiting for remote server queues, and complete privacy for all your visual assets. You can also explore our modern formats by converting <a href='/webp-to-png/' class='text-accent hover:underline'>WebP to PNG</a> for maximum compatibility."
    ]}
    faqs={faqs}
    relatedHeading="Related Image Converters"
    relatedLinks={relatedLinks}
  />

  <Footer />
</BaseLayout>
