---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import UploadDropzone from '../components/UploadDropzone.astro';
---

<BaseLayout
  title="Compress Images Online – Free Image Compressor | FixMyImage"
  description="Compress JPG, PNG and WebP images to a target file size directly in your browser. Supports multiple images with ZIP download."
>
  <Header />

  <main class="flex-grow flex flex-col items-center justify-center px-4 py-12 md:py-24 bg-canvas">
    <div class="w-full max-w-4xl mx-auto text-center">

      <UploadDropzone />
    </div>
  </main>

  <Footer />
</BaseLayout>
