---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import UploadDropzone from '../components/UploadDropzone.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
  title={t('metadata.compress_title')}
  description={t('metadata.compress_desc')}
>
  <Header />

  <main class="flex-grow flex flex-col items-center px-4 py-12 md:py-20 bg-canvas">
    <div class="w-full max-w-4xl mx-auto">

      <UploadDropzone />
    </div>
  </main>

  <Footer />
</BaseLayout>
