---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const title = "Contact Us – Support, Bug Reports & Inquiries | FixMyImage";
const description = "Have a question, feedback, or found a bug? Contact the FixMyImage team. We read every message and respond promptly.";
const canonicalUrl = "https://fixmyimage.app/contact/";

const contactFaqs = [
  {
    q: "How quickly do you respond to support inquiries?",
    a: "We are a focused team, but we read every inquiry and typically respond within 24 to 48 business hours."
  },
  {
    q: "Why did an image fail to process or display an error?",
    a: "Because all processing occurs in your browser, errors are usually caused by corrupted input files, unsupported browser features (such as older browsers lacking AVIF support), or insufficient device memory for exceptionally large photos."
  },
  {
    q: "Do you offer a cloud API or developer integration?",
    a: "Currently, FixMyImage is focused exclusively on providing free, private, client-side browser tools. If you have high-volume developer inquiries, reach out by email."
  },
  {
    q: "How can I report a bug effectively?",
    a: "Please include your browser name and version, your device operating system, the image format you were processing, and any error message displayed."
  }
];

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact FixMyImage",
  "description": description,
  "url": canonicalUrl,
  "mainEntity": {
    "@type": "Organization",
    "name": "FixMyImage",
    "url": "https://fixmyimage.app",
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "hello@fixmyimage.app",
      "contactType": "Customer Support",
      "availableLanguage": ["English", "Spanish"]
    }
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": contactFaqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
>
  <Header />

  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <main class="flex-grow max-w-4xl mx-auto w-full px-4 sm:px-6 py-12 md:py-20 text-ink">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-[13px] text-mute mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink transition-colors">Home</a>
      <span>/</span>
      <span class="text-ink font-medium">Contact Us</span>
    </nav>

    <!-- Header Section -->
    <header class="text-center max-w-2xl mx-auto mb-12">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-ink mb-4">
        Get in Touch
      </h1>
      <p class="text-base sm:text-lg text-body leading-relaxed">
        Have feedback, found a bug, or want to suggest a new tool? We'd love to hear from you. We read and appreciate every message.
      </p>
    </header>

    <!-- Primary Email Card -->
    <div class="bg-canvas-elevated border border-hairline rounded-2xl p-8 sm:p-12 text-center max-w-xl mx-auto shadow-sm mb-14">
      <div class="w-14 h-14 bg-accent/10 text-accent rounded-full flex items-center justify-center mx-auto mb-5">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
      </div>
      <h2 class="text-xl font-bold text-ink mb-2">Email Our Team</h2>
      <p class="text-sm text-body mb-6">
        Direct all support, bug reports, and general feedback to:
      </p>
      <a
        href="mailto:hello@fixmyimage.app"
        class="inline-flex items-center justify-center bg-accent text-white font-bold text-lg py-3 px-8 rounded-full hover:bg-accent/90 transition-transform hover:scale-105 shadow-lg shadow-accent/20"
      >
        hello@fixmyimage.app
      </a>
      <p class="text-xs text-mute mt-4">
        Expected response time: within 24 to 48 hours
      </p>
    </div>

    <!-- Inquiry Types Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      <div class="border border-hairline rounded-xl p-6 bg-canvas">
        <div class="font-bold text-ink text-base mb-2 flex items-center gap-2">
          <span>🐛</span> Bug Reports
        </div>
        <p class="text-sm text-body">
          Encountered an issue with an image? Tell us your browser, operating system, and file format so we can reproduce and fix it quickly.
        </p>
      </div>
      <div class="border border-hairline rounded-xl p-6 bg-canvas">
        <div class="font-bold text-ink text-base mb-2 flex items-center gap-2">
          <span>💡</span> Feature Requests
        </div>
        <p class="text-sm text-body">
          Need support for another format or specific resolution preset? We prioritize new tools and options based on user demand.
        </p>
      </div>
      <div class="border border-hairline rounded-xl p-6 bg-canvas">
        <div class="font-bold text-ink text-base mb-2 flex items-center gap-2">
          <span>🤝</span> General Inquiries
        </div>
        <p class="text-sm text-body">
          For educational partnerships, press inquiries, or questions regarding our client-side architecture and privacy guidelines.
        </p>
      </div>
    </div>

    <!-- Support FAQ Section -->
    <section class="border-t border-hairline pt-12 mb-16">
      <h2 class="text-2xl sm:text-3xl font-bold text-ink mb-8 text-center sm:text-left">
        Frequently Asked Questions
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {contactFaqs.map(faq => (
          <div class="border border-hairline rounded-xl p-6 bg-canvas-elevated">
            <h3 class="font-bold text-ink text-[16px] mb-2">{faq.q}</h3>
            <p class="text-[14px] text-body leading-relaxed">{faq.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Quick Tool Navigation -->
    <section class="border-t border-hairline pt-12">
      <h2 class="text-lg font-bold text-ink mb-4">Explore Our Free Tools</h2>
      <div class="flex flex-wrap gap-3">
        <a href="/compress-image/" class="px-3.5 py-2 text-sm font-medium border border-hairline rounded-lg bg-canvas hover:border-ink/30 transition-colors text-body hover:text-ink">
          Compress Images
        </a>
        <a href="/resize-image/" class="px-3.5 py-2 text-sm font-medium border border-hairline rounded-lg bg-canvas hover:border-ink/30 transition-colors text-body hover:text-ink">
          Resize Images
        </a>
        <a href="/convert-image/" class="px-3.5 py-2 text-sm font-medium border border-hairline rounded-lg bg-canvas hover:border-ink/30 transition-colors text-body hover:text-ink">
          Convert Images
        </a>
        <a href="/watermark-image/" class="px-3.5 py-2 text-sm font-medium border border-hairline rounded-lg bg-canvas hover:border-ink/30 transition-colors text-body hover:text-ink">
          Watermark Images
        </a>
        <a href="/about/" class="px-3.5 py-2 text-sm font-medium border border-hairline rounded-lg bg-canvas hover:border-ink/30 transition-colors text-body hover:text-ink">
          About FixMyImage
        </a>
        <a href="/privacy/" class="px-3.5 py-2 text-sm font-medium border border-hairline rounded-lg bg-canvas hover:border-ink/30 transition-colors text-body hover:text-ink">
          Privacy Policy
        </a>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
