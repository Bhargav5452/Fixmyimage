---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Contact | FixMyImage"
  description="Get in touch with the FixMyImage team. We'd love to hear your feedback or bug reports."
>
  <Header />
  <main class="flex-grow max-w-3xl mx-auto w-full px-4 py-12 md:py-20 text-ink text-center">
    <h1 class="text-4xl font-extrabold text-ink mb-4">Contact</h1>
    <p class="text-lg text-body mb-8 max-w-xl mx-auto">
      Found a bug, have a suggestion, or just want to say hello? Drop us an email.
    </p>
    <a
      href="mailto:hello@fixmyimage.app"
      class="inline-flex items-center justify-center bg-primary hover:bg-ink/90 text-on-primary font-medium text-[16px] py-[12px] px-[32px] rounded-full transition-all shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
    >
      hello@fixmyimage.app
    </a>
    <p class="mt-10 text-sm text-body">
      We're a small project, but we read every message.
    </p>
  </main>
  <Footer />
</BaseLayout>
