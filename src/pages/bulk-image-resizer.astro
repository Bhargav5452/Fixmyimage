---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ResizeDropzone from '../components/ResizeDropzone.astro';

const title = "Bulk Image Resizer – Resize Multiple Images Online | FixMyImage";
const desc = "Resize multiple images at once with the same settings.";
---

<BaseLayout title={title} description={desc} canonical="https://fixmyimage.app/bulk-image-resizer">
  <Header />
  
  <main class="flex-grow flex flex-col items-center px-4 py-12 md:py-20 bg-canvas">
    <div class="w-full max-w-4xl mx-auto">
      
      <div class="mb-12">
        <ResizeDropzone 
          h1="Bulk Image Resizer" 
          subtitle="Resize multiple images at once with the same settings." 
          initialMode="custom" 
        />
      </div>



    </div>
  </main>
  
  <Footer />
</BaseLayout>
