---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import UploadDropzone from '../components/UploadDropzone.astro';
import SeoContent from '../components/SeoContent.astro';
import { getSpanishFaqsForRoute } from '../data/spanishFaqs';

const title = "Comprimir imagen a 1 MB online gratis | FixMyImage";
const description = "Comprime fotos e imágenes a menos de 1 MB online gratis. Ideal para subir a portales de empleo, inscripciones oficiales y correo electrónico.";
const canonicalUrl = "https://fixmyimage.app/comprimir-imagen-a-1-mb";

const faqs = getSpanishFaqsForRoute('/comprimir-imagen-a-1-mb');

const relatedLinks = [
  { label: "Comprimir imagen", href: "/comprimir-imagen" },
  { label: "Comprimir imagen a 50 KB", href: "/comprimir-imagen-a-50-kb" },
  { label: "Comprimir imagen a 100 KB", href: "/comprimir-imagen-a-100-kb" },
  { label: "Redimensionar imagen", href: "/redimensionar-imagen" },
  { label: "Convertir imagen", href: "/convertir-imagen" }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  lang="es"
>
  <Header />

  <main class="flex-grow flex flex-col items-center justify-start px-4 pt-8 md:pt-12 pb-12 md:pb-16 bg-canvas min-h-[calc(100vh-72px)]">
    <div class="w-full max-w-[960px] mx-auto">
      <UploadDropzone
        h1="Comprimir imagen a 1 MB online"
        subtitle="Reduce el peso de imágenes pesadas tomadas con cámara o móvil a menos de 1 MB de forma instantánea."
        presetValue="1"
        presetUnit="MB"
      />
    </div>
  </main>

  <SeoContent
    heading="Comprime fotos de alta resolución a 1 MB manteniendo su calidad visual"
    paragraphs={[
      "Las fotos capturadas con cámaras digitales modernas o teléfonos de gama alta suelen ocupar entre 5 y 15 MB, superando los límites permitidos para adjuntar en emails o subir a plataformas web. FixMyImage te permite comprimir imágenes a 1 MB de forma rápida, conservando una excelente resolución y definición de color.",
      "Con nuestro procesamiento en el navegador, tus fotos no se transfieren por la red, garantizando un flujo de trabajo privado, fluido y sin pérdida de tiempo."
    ]}
    faqs={faqs}
    faqHeading="Preguntas frecuentes sobre comprimir a 1 MB"
    relatedHeading="Otras opciones de compresión"
    relatedLinks={relatedLinks}
  />

  <Footer />
</BaseLayout>
