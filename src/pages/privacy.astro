---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const title = "Privacy Policy – Zero Server Uploads & Local Processing | FixMyImage";
const description = "Read FixMyImage's Privacy Policy. All image compression, resizing, conversion, and watermarking happen 100% locally in your browser. We never upload or store your files.";
const canonicalUrl = "https://fixmyimage.app/privacy/";

const privacySchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Privacy Policy",
  "description": description,
  "url": canonicalUrl,
  "publisher": {
    "@type": "Organization",
    "name": "FixMyImage",
    "url": "https://fixmyimage.app/"
  }
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
>
  <Header />

  <script type="application/ld+json" set:html={JSON.stringify(privacySchema)} />

  <main class="flex-grow max-w-4xl mx-auto w-full px-4 sm:px-6 py-12 md:py-20 text-ink">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-[13px] text-mute mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink transition-colors">Home</a>
      <span>/</span>
      <span class="text-ink font-medium">Privacy Policy</span>
    </nav>

    <header class="mb-10">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-ink mb-3">
        Privacy Policy
      </h1>
      <p class="text-sm text-mute">Effective Date: September 30, 2026</p>
    </header>

    <!-- Summary Box -->
    <div class="bg-canvas-elevated border-2 border-accent/20 rounded-2xl p-6 sm:p-8 mb-12">
      <h2 class="text-xl font-bold text-ink mb-3">The Short Version (Summary)</h2>
      <p class="text-[15px] sm:text-[16px] leading-relaxed text-body mb-3">
        FixMyImage is engineered from the ground up as a <strong class="text-ink">client-side application</strong>. When you use our tools to compress, resize, convert, or watermark images, your files <strong class="text-ink">never leave your device</strong>.
      </p>
      <p class="text-[15px] sm:text-[16px] leading-relaxed text-body">
        We operate no backend ingestion servers, maintain no databases of user images, require no user accounts, and your image data is never uploaded or tracked. We use basic website analytics (Google Analytics) to understand aggregate traffic and performance. When you close your browser tab, all image processing session memory is automatically erased by your device's browser sandbox.
      </p>
    </div>

    <div class="space-y-10 text-[15px] sm:text-[16px] leading-relaxed text-body">
      
      <!-- Section 1 -->
      <section>
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-3">1. Zero Image Data Collection or Uploads</h2>
        <p class="mb-3">
          Traditional web converters upload your files to remote cloud servers to perform CPU-intensive tasks. In contrast, FixMyImage executes all algorithms directly inside your client browser environment using the HTML5 Canvas API, WebAssembly modules, and Web Workers.
        </p>
        <p>
          At no point are your images, image metadata (EXIF/GPS), filenames, or rendered outputs transmitted over the network to FixMyImage or any external third party. Your files remain exclusively in your local machine's volatile memory.
        </p>
      </section>

      <!-- Section 2 -->
      <section>
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-3">2. Personal Information &amp; Account Data</h2>
        <p class="mb-3">
          FixMyImage does not require account creation, registration, email sign-ups, or phone number verification to use any of our utilities. We do not collect or request:
        </p>
        <ul class="list-disc list-inside space-y-1.5 ml-2 mb-3">
          <li>Names, postal addresses, or phone numbers</li>
          <li>Payment information, credit cards, or billing details</li>
          <li>Social media profiles or external account authentications</li>
        </ul>
        <p>
          If you voluntarily contact us via email, we collect only your email address and message contents solely for the purpose of answering your inquiry or troubleshooting reported bugs. We do not subscribe your email address to marketing mailing lists.
        </p>
      </section>

      <!-- Section 3 -->
      <section>
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-3">3. Website Analytics, Cookies &amp; Browser Storage</h2>
        <p class="mb-3">
          Your image files and processing activities are never tracked. To monitor general website traffic, stability, and aggregate usage patterns (such as page views, device types, and general geographical region), we use Google Analytics. Google Analytics may set first-party cookies to distinguish unique sessions and measure aggregate visitor interactions.
        </p>
        <p class="mb-3">
          Google Analytics does not collect, inspect, or receive your uploaded files, processed images, or image metadata. All image computation remains strictly within your browser.
        </p>
        <p>
          We also use standard browser <code class="text-xs bg-canvas px-1.5 py-0.5 rounded border border-hairline font-mono">localStorage</code> to remember your selected user interface theme preference (<code class="text-xs bg-canvas px-1.5 py-0.5 rounded border border-hairline font-mono">theme: 'light' | 'dark'</code>). This data resides entirely on your device and is never sent across the internet.
        </p>
      </section>

      <!-- Section 4 -->
      <section>
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-3">4. Edge Hosting Infrastructure &amp; Technical Logs</h2>
        <p class="mb-3">
          Our website assets (HTML, CSS, JavaScript files) are statically hosted and served via Cloudflare Pages edge delivery networks. Like virtually all web servers, Cloudflare may collect standard operational server logs strictly to maintain uptime, protect against DDoS cyberattacks, and fulfill security requirements. These logs may include:
        </p>
        <ul class="list-disc list-inside space-y-1.5 ml-2 mb-3">
          <li>Your IP address and general geographic region (country/city level)</li>
          <li>Browser user agent and operating system version</li>
          <li>Requested web pages and HTTP status codes</li>
          <li>Date and timestamp of HTTP asset requests</li>
        </ul>
        <p>
          These operational logs are managed under <a href="https://www.cloudflare.com/privacypolicy/" target="_blank" rel="noopener noreferrer" class="text-link hover:underline">Cloudflare's Privacy Policy</a> and contain zero image files or image processing payload.
        </p>
      </section>

      <!-- Section 5 -->
      <section>
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-3">5. Global Privacy Compliance by Architecture (GDPR, CCPA, CPRA, COPPA)</h2>
        <p class="mb-3">
          Because FixMyImage intentionally avoids collecting, storing, processing, or selling personal data or files, our architecture inherently complies with global privacy legislation:
        </p>
        <ul class="space-y-3 mt-3">
          <li class="border-l-2 border-hairline pl-4">
            <strong class="text-ink">European Union GDPR:</strong> We collect zero personal image data, process all photos strictly on your device, and only use aggregated analytics to monitor website health and performance.
          </li>
          <li class="border-l-2 border-hairline pl-4">
            <strong class="text-ink">California Consumer Privacy Act (CCPA / CPRA):</strong> We do not sell, rent, or share personal information or consumer files under any circumstances.
          </li>
          <li class="border-l-2 border-hairline pl-4">
            <strong class="text-ink">Children's Online Privacy Protection Act (COPPA):</strong> We do not knowingly collect information from children under 13, nor does our service require any data entry.
          </li>
        </ul>
      </section>

      <!-- Section 6 -->
      <section>
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-3">6. External Links &amp; Third-Party Services</h2>
        <p>
          Our pages may contain links to external websites, documentation, or legal resources. FixMyImage has no control over the privacy practices or content of third-party platforms. We encourage you to review the privacy documentation of any external sites you visit.
        </p>
      </section>

      <!-- Section 7 -->
      <section>
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-3">7. Revisions to this Privacy Policy</h2>
        <p>
          We may update this Privacy Policy periodically to reflect enhancements in technology, service features, or regulatory guidance. Any modifications will be posted directly to this page with an updated effective date. Your continued use of the website signifies acceptance of any updated terms.
        </p>
      </section>

      <!-- Section 8 -->
      <section class="border-t border-hairline pt-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-3">8. Contact Us Regarding Privacy</h2>
        <p class="mb-4">
          If you have any questions, suggestions, or concerns regarding this Privacy Policy or our client-side architecture, please reach out directly:
        </p>
        <div class="bg-canvas border border-hairline rounded-xl p-5 inline-block">
          <p class="text-ink font-semibold">FixMyImage Privacy Team</p>
          <p class="text-sm text-body mt-1">
            Email: <a href="mailto:hello@fixmyimage.app" class="text-link hover:underline font-medium">hello@fixmyimage.app</a>
          </p>
          <p class="text-sm text-mute mt-1">
            Web: <a href="/contact/" class="text-link hover:underline">fixmyimage.app/contact</a>
          </p>
        </div>
      </section>

    </div>
  </main>
  <Footer />
</BaseLayout>
