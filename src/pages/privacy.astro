---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
  title="Privacy Policy | FixMyImage"
  description="FixMyImage processes all images locally in your browser. We never upload, store or access your files."
>
  <Header />
  <main class="flex-grow max-w-3xl mx-auto w-full px-4 py-12 md:py-20 text-ink">
    <h1 class="text-4xl font-extrabold text-ink mb-4">Privacy Policy</h1>
    <p class="text-body text-sm mb-10">Last updated: September 2026</p>

    <div class="space-y-8 text-[15px] leading-relaxed text-body">

      <section>
        <h2 class="text-xl font-bold text-ink mb-3">The short version</h2>
        <p>
          FixMyImage is a browser-side tool. <strong class="text-ink">Your images never leave your device.</strong>
          We have no servers that receive, store or process your files. Everything happens locally using
          your browser's built-in capabilities.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-ink mb-3">What data we collect</h2>
        <p>
          We do not collect any personally identifiable information. We do not require an account.
          We do not ask for your email address. We do not use cookies for tracking.
        </p>
        <p class="mt-3">
          If you contact us by email, we receive only what you send us and we use it solely to respond to you.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-ink mb-3">How image processing works</h2>
        <p>
          All image compression, resizing, format conversion and watermarking is performed entirely
          inside your web browser using the Canvas API and WebAssembly. Your files are never uploaded
          to any server. They do not pass through our infrastructure at any point.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-ink mb-3">Analytics</h2>
        <p>
          We may use privacy-friendly, anonymous page-view analytics (no cookies, no fingerprinting,
          no personal data) to understand basic traffic patterns. We do not sell this data to third parties.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-ink mb-3">Third-party services</h2>
        <p>
          The site is hosted on Cloudflare Pages. Cloudflare may log basic request metadata (IP address,
          request path, timestamp) as part of standard server operation. Please refer to
          <a href="https://www.cloudflare.com/privacypolicy/" class="text-link hover:underline" target="_blank" rel="noopener noreferrer">Cloudflare's Privacy Policy</a>
          for details.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-ink mb-3">Changes to this policy</h2>
        <p>
          If we make material changes to this policy, we will update the date at the top of this page.
          Continued use of FixMyImage after any change constitutes acceptance of the new policy.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-ink mb-3">Contact</h2>
        <p>
          Questions about privacy? Email us at
          <a href="mailto:hello@fixmyimage.app" class="text-link hover:underline">hello@fixmyimage.app</a>.
        </p>
      </section>

    </div>
  </main>
  <Footer />
</BaseLayout>
