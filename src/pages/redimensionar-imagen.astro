---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ResizeDropzone from '../components/ResizeDropzone.astro';
import SeoContent from '../components/SeoContent.astro';
import { getSpanishFaqsForRoute } from '../data/spanishFaqs';

const title = "Redimensionar imagen online gratis – Cambiar tamaño de fotos | FixMyImage";
const description = "Redimensiona imágenes online gratis. Cambia el tamaño de tus fotos en píxeles, porcentaje o medidas exactas sin perder calidad ni subir archivos a servidores.";
const canonicalUrl = "https://fixmyimage.app/redimensionar-imagen";

const faqs = getSpanishFaqsForRoute('/redimensionar-imagen');

const relatedLinks = [
  { label: "Redimensionar en píxeles", href: "/redimensionar-imagen-en-pixeles" },
  { label: "Redimensionar en cm (imprimir)", href: "/redimensionar-imagen-en-cm" },
  { label: "Redimensionar por lotes", href: "/redimensionar-imagenes-por-lotes" },
  { label: "Comprimir imagen", href: "/comprimir-imagen" },
  { label: "Convertir imágenes", href: "/convertir-imagen" }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  lang="es"
>
  <Header />

  <main class="flex-grow flex flex-col items-center justify-start px-4 pt-8 md:pt-12 pb-12 md:pb-16 bg-canvas min-h-[calc(100vh-72px)]">
    <div class="w-full max-w-[960px] mx-auto">
      <ResizeDropzone
        h1="Redimensionar imágenes online"
        subtitle="Cambia el tamaño de tus fotos por píxeles o porcentaje fácilmente. Ajusta dimensiones al instante con privacidad garantizada."
      />
    </div>
  </main>

  <SeoContent
    heading="Redimensionador de imágenes online rápido y privado"
    paragraphs={[
      "FixMyImage te permite redimensionar imágenes y cambiar el tamaño de tus fotos online con total precisión. Puedes establecer la anchura y altura exactas en píxeles, escalar proporcionalmente mediante porcentaje o utilizar medidas en centímetros calibradas para impresión en alta definición.",
      "Todo el procesamiento se lleva a cabo directamente en tu navegador mediante tecnologías web modernas. Tus fotografías no se envían a ningún servidor, garantizando máxima velocidad y total privacidad en tus archivos personales y profesionales."
    ]}
    faqs={faqs}
    faqHeading="Preguntas frecuentes sobre redimensionar imágenes"
    relatedHeading="Herramientas y modos de redimensión"
    relatedLinks={relatedLinks}
  />

  <Footer />
</BaseLayout>
