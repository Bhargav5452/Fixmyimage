---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ResizeDropzone from '../components/ResizeDropzone.astro';
import SeoContent from '../components/SeoContent.astro';

import { getFaqsForRoute } from '../data/curatedFaqs';

const title = "Resize Image in CM Online – Free Image Resizer | FixMyImage";
const desc = "Resize images using custom width and height in centimeters online for free. Prepare photos for printing and document forms with DPI support.";
const canonicalUrl = "https://fixmyimage.app/resize-image-in-cm";

const faqs = getFaqsForRoute('/resize-image-in-cm');

const relatedLinks = [
  { label: "Resize in Pixels", href: "/resize-image-in-pixels" },
  { label: "Bulk Image Resizer", href: "/bulk-image-resizer" },
  { label: "General Image Resizer", href: "/resize-image" },
  { label: "Compress to 50KB", href: "/compress-image-to-50kb" },
  { label: "Convert Images", href: "/convert-image" }
];
---

<BaseLayout title={title} description={desc} canonical={canonicalUrl}>
  <Header />
  
  <main class="flex-grow flex flex-col items-center justify-center px-4 py-12 md:py-16 bg-canvas min-h-[calc(100vh-72px)]">
    <div class="w-full max-w-4xl mx-auto">
      <ResizeDropzone 
        h1="Resize Image in Centimeters" 
        subtitle="Resize images using custom width and height in centimeters." 
        initialMode="cm" 
      />
    </div>
  </main>
  
  <SeoContent
    heading="Resize Images to Exact Centimeter Measurements"
    paragraphs={[
      "When preparing images for physical printing, ID documents, or formal applications, measurements are typically specified in centimeters rather than screen pixels. FixMyImage makes it simple to configure exact centimeter dimensions with automatic DPI calibration.",
      "Whether you are sizing pictures for standard photo frames or submitting government forms, our in-browser tool delivers accurately sized files ready for print without any cloud uploads or software installation."
    ]}
    faqs={faqs}
    relatedHeading="Related Resizing & Compression Tools"
    relatedLinks={relatedLinks}
  />

  <Footer />
</BaseLayout>
