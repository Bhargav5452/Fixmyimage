---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ResizeDropzone from '../components/ResizeDropzone.astro';
import SeoContent from '../components/SeoContent.astro';

import { getFaqsForRoute } from '../data/curatedFaqs';

const title = "Resize Image in CM Online – Free Image Resizer | FixMyImage";
const desc = "Resize images using custom width and height in centimeters online for free. Prepare photos for printing and document forms with DPI support.";
const canonicalUrl = "https://fixmyimage.app/resize-image-in-cm";

const faqs = getFaqsForRoute('/resize-image-in-cm');

const relatedLinks = [
  { label: "Resize in Pixels", href: "/resize-image-in-pixels" },
  { label: "Bulk Image Resizer", href: "/bulk-image-resizer" },
  { label: "General Image Resizer", href: "/resize-image" },
  { label: "Compress to 50KB", href: "/compress-image-to-50kb" },
  { label: "Convert Images", href: "/convert-image" }
];
---

<BaseLayout title={title} description={desc} canonical={canonicalUrl}>
  <Header />
  
  <main class="flex-grow flex flex-col items-center justify-start px-4 pt-[15vh] md:pt-[20vh] pb-12 md:pb-16 bg-canvas min-h-[calc(100vh-72px)]">
    <div class="w-full max-w-[1150px] mx-auto">
      <ResizeDropzone 
        h1="Resize Image in Centimeters" 
        subtitle="Resize images using custom width and height in centimeters." 
        initialMode="cm" 
      />
    </div>
  </main>
  
  <SeoContent
    heading="Resize Images to Exact Centimeter Measurements"
    paragraphs={[
      "When preparing images for physical printing, ID documents, or formal applications, measurements are typically specified in centimeters rather than screen pixels. FixMyImage's versatile <a href='/resize-image/' class='text-accent hover:underline'>image resizer</a> makes it simple to configure exact centimeter dimensions with automatic DPI calibration. If you need dimensions for web rather than print, easily switch to <a href='/resize-image-in-pixels/' class='text-accent hover:underline'>resize in pixels</a>.",
      "Whether you are sizing pictures for standard photo frames or submitting government forms, our in-browser tool delivers accurately sized files ready for print without any cloud uploads or software installation. To process multiple printing assets at the same time, explore our <a href='/bulk-image-resizer/' class='text-accent hover:underline'>bulk image resizer</a>."
    ]}
    faqs={faqs}
    relatedHeading="Related Resizing & Compression Tools"
    relatedLinks={relatedLinks}
  />

  <Footer />
</BaseLayout>
