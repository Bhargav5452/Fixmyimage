---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ResizeDropzone from '../components/ResizeDropzone.astro';

const title = "Resize Image in CM Online – Free Image Resizer | FixMyImage";
const desc = "Resize images using custom width and height in centimeters.";
---

<BaseLayout title={title} description={desc} canonical="https://fixmyimage.app/resize-image-in-cm">
  <Header />
  
  <main class="flex-grow flex flex-col items-center px-4 py-12 md:py-20 bg-canvas">
    <div class="w-full max-w-4xl mx-auto">
      
      <div class="mb-12">
        <ResizeDropzone 
          h1="Resize Image in Centimeters" 
          subtitle="Resize images using custom width and height in centimeters." 
          initialMode="cm" 
        />
      </div>



    </div>
  </main>
  
  <Footer />
</BaseLayout>
