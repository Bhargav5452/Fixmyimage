---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WatermarkDropzone from '../components/WatermarkDropzone.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
  title={t('metadata.watermark_title')}
  description={t('metadata.watermark_desc')}
>
  <Header />
  <main class="flex-grow flex flex-col items-center px-4 py-12 md:py-20 bg-canvas">
    <div class="w-full max-w-4xl mx-auto">

      <WatermarkDropzone />
    </div>
  </main>
  <Footer />
</BaseLayout>
