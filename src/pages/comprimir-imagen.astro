---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import UploadDropzone from '../components/UploadDropzone.astro';
import SeoContent from '../components/SeoContent.astro';
import { getSpanishFaqsForRoute } from '../data/spanishFaqs';

const title = "Comprimir imágenes online gratis – Reducir tamaño JPG, PNG y WebP | FixMyImage";
const description = "Comprime imágenes y fotos online gratis. Reduce el peso de archivos JPG, PNG y WebP directamente en tu navegador sin perder calidad visual y con total privacidad.";
const canonicalUrl = "https://fixmyimage.app/comprimir-imagen";

const faqs = getSpanishFaqsForRoute('/comprimir-imagen');

const relatedLinks = [
  { label: "Comprimir imagen a 50 KB", href: "/comprimir-imagen-a-50-kb" },
  { label: "Comprimir imagen a 100 KB", href: "/comprimir-imagen-a-100-kb" },
  { label: "Comprimir imagen a 1 MB", href: "/comprimir-imagen-a-1-mb" },
  { label: "Redimensionar imagen", href: "/redimensionar-imagen" },
  { label: "Convertir imágenes", href: "/convertir-imagen" },
  { label: "Redimensionar por lotes", href: "/redimensionar-imagenes-por-lotes" }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  lang="es"
>
  <Header />

  <main class="flex-grow flex flex-col items-center justify-start px-4 pt-8 md:pt-12 pb-12 md:pb-16 bg-canvas min-h-[calc(100vh-72px)]">
    <div class="w-full max-w-[960px] mx-auto">
      <UploadDropzone
        h1="Comprimir imágenes online"
        subtitle="Reduce el peso de tus fotos e imágenes JPG, PNG y WebP sin perder calidad. Procesamiento rápido y 100% privado en tu navegador."
      />
    </div>
  </main>

  <SeoContent
    heading="Compresor de imágenes online rápido, potente y privado"
    paragraphs={[
      "FixMyImage te ofrece una solución intuitiva y eficaz para comprimir imágenes y optimizar fotos en formatos JPG, PNG y WebP sin sacrificar nitidez visual. Ya sea para acelerar los tiempos de carga en tu página web, adjuntar documentos en correos electrónicos o cumplir los requisitos de peso en trámites oficiales, puedes reducir el tamaño de tus archivos en cuestión de segundos.",
      "Nuestro motor de compresión inteligente opera directamente en la memoria de tu navegador, garantizando que tus fotos nunca se transmitan a servidores externos ni a la nube. Este enfoque local garantiza privacidad absoluta, velocidad en tiempo real y la libertad de comprimir fotos por lotes sin ningún tipo de límite ni suscripción."
    ]}
    faqs={faqs}
    faqHeading="Preguntas frecuentes sobre comprimir fotos e imágenes"
    relatedHeading="Tamaños objetivo y herramientas recomendadas"
    relatedLinks={relatedLinks}
  />

  <Footer />
</BaseLayout>
