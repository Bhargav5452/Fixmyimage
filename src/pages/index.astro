---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoContent from '../components/SeoContent.astro';
import { getLangFromUrl, getRelativeLocaleUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const homeFaqs = [
  {
    q: "Is FixMyImage completely free to use?",
    a: "Yes. All tools on FixMyImage are 100% free with no hidden charges, subscriptions, usage quotas, or account sign-ups."
  },
  {
    q: "Are my photos uploaded or stored on any server?",
    a: "No. All image processing executes strictly within your web browser on your local device, ensuring your pictures remain entirely private."
  },
  {
    q: "Can I process multiple images at the same time?",
    a: "Yes. FixMyImage supports bulk batch processing, allowing you to compress, resize, convert, or watermark multiple photos simultaneously."
  },
  {
    q: "Does FixMyImage add watermarks to my processed files?",
    a: "No. Your downloaded images remain clean and unaltered, unless you intentionally use our watermark tool to apply your own logo or text."
  }
];

const homeRelatedLinks = [
  { label: "Image Compressor", href: "/compress-image" },
  { label: "Image Resizer", href: "/resize-image" },
  { label: "Bulk Image Resizer", href: "/bulk-image-resizer" },
  { label: "Image Converter", href: "/convert-image" },
  { label: "Watermark Tool", href: "/watermark-image" },
  { label: "Compress to 50KB", href: "/compress-image-to-50kb" },
  { label: "Compress to 100KB", href: "/compress-image-to-100kb" },
  { label: "JPG to PNG", href: "/jpg-to-png" },
  { label: "PNG to JPG", href: "/png-to-jpg" },
  { label: "WebP to JPG", href: "/webp-to-jpg" }
];
---

<BaseLayout
  title={t('metadata.home_title')}
  description={t('metadata.home_desc')}
  canonical="https://fixmyimage.app"
>
  <Header />

  <main class="flex-grow">

    <section id="tools" class="bg-canvas">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 md:py-20">
        
        <!-- Hero Text -->
        <div class="max-w-2xl mx-auto flex flex-col items-center text-center mb-12">
          <h1 class="text-[36px] sm:text-[48px] font-bold tracking-tight text-ink leading-[1.1] mb-5 text-balance">
            Every tool you could want to edit images in bulk
          </h1>
          <p class="text-[17px] sm:text-[18px] text-body leading-relaxed max-w-lg mx-auto">
            Your online photo editor is here and forever free!
          </p>
        </div>

        <!-- All tools: 4-col single row -->
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">

        <a href={getRelativeLocaleUrl(lang, 'compress-image')} class="group relative flex flex-col justify-between p-6 sm:p-8 bg-canvas-elevated border border-hairline rounded-2xl hover:border-accent/30 hover:shadow-md transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">
          <div>
            <div class="relative flex items-center justify-center w-12 h-12 rounded-xl bg-canvas border border-hairline shadow-sm mb-5 group-hover:scale-105 group-hover:shadow transition-all duration-300" aria-hidden="true">
              <div class="absolute inset-0 rounded-xl bg-gradient-to-b from-white/60 to-transparent dark:from-white/5 pointer-events-none"></div>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-ink/80 group-hover:text-accent transition-colors">
                <path d="M8 3v3a2 2 0 0 1-2 2H3"/><path d="M21 8h-3a2 2 0 0 1-2-2V3"/>
                <path d="M3 16h3a2 2 0 0 1 2 2v3"/><path d="M16 21v-3a2 2 0 0 1 2-2h3"/>
              </svg>
            </div>
            <h2 class="text-[18px] font-semibold text-ink mb-1.5 tracking-[-0.01em]">{t('home.compress_title')}</h2>
            <p class="text-[14px] text-body leading-relaxed">{t('home.compress_desc')}</p>
          </div>
          <div class="mt-6 flex items-center gap-1.5 text-[13px] font-medium text-accent">
            {t('home.compress_title')}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-0.5 transition-transform" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>
        </a>

        <a href={getRelativeLocaleUrl(lang, 'resize-image')} class="group relative flex flex-col justify-between p-6 sm:p-8 bg-canvas-elevated border border-hairline rounded-2xl hover:border-accent/30 hover:shadow-md transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">
          <div>
            <div class="relative flex items-center justify-center w-12 h-12 rounded-xl bg-canvas border border-hairline shadow-sm mb-5 group-hover:scale-105 group-hover:shadow transition-all duration-300" aria-hidden="true">
              <div class="absolute inset-0 rounded-xl bg-gradient-to-b from-white/60 to-transparent dark:from-white/5 pointer-events-none"></div>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-ink/80 group-hover:text-accent transition-colors">
                <path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                <path d="M14 15H9v-5"/><path d="M16 3h5v5"/><path d="M21 3l-6 6"/>
              </svg>
            </div>
            <h2 class="text-[18px] font-semibold text-ink mb-1.5 tracking-[-0.01em]">{t('home.resize_title')}</h2>
            <p class="text-[14px] text-body leading-relaxed">{t('home.resize_desc')}</p>
          </div>
          <div class="mt-6 flex items-center gap-1.5 text-[13px] font-medium text-accent">
            {t('home.resize_title')}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-0.5 transition-transform" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>
        </a>

        <a href={getRelativeLocaleUrl(lang, 'convert-image')} class="group relative flex flex-col justify-between p-6 sm:p-8 bg-canvas-elevated border border-hairline rounded-2xl hover:border-accent/30 hover:shadow-md transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">
          <div>
            <div class="relative flex items-center justify-center w-12 h-12 rounded-xl bg-canvas border border-hairline shadow-sm mb-5 group-hover:scale-105 group-hover:shadow transition-all duration-300" aria-hidden="true">
              <div class="absolute inset-0 rounded-xl bg-gradient-to-b from-white/60 to-transparent dark:from-white/5 pointer-events-none"></div>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-ink/80 group-hover:text-accent transition-colors">
                <path d="M8 3 4 7l4 4"/><path d="M4 7h16"/><path d="m16 21 4-4-4-4"/><path d="M20 17H4"/>
              </svg>
            </div>
            <h2 class="text-[18px] font-semibold text-ink mb-1.5 tracking-[-0.01em]">{t('home.convert_title')}</h2>
            <p class="text-[14px] text-body leading-relaxed">{t('home.convert_desc')}</p>
          </div>
          <div class="mt-6 flex items-center gap-1.5 text-[13px] font-medium text-accent">
            {t('home.convert_title')}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-0.5 transition-transform" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>
        </a>

        <a href={getRelativeLocaleUrl(lang, 'watermark-image')} class="group relative flex flex-col justify-between p-6 sm:p-8 bg-canvas-elevated border border-hairline rounded-2xl hover:border-accent/30 hover:shadow-md transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">
          <div>
            <div class="relative flex items-center justify-center w-12 h-12 rounded-xl bg-canvas border border-hairline shadow-sm mb-5 group-hover:scale-105 group-hover:shadow transition-all duration-300" aria-hidden="true">
              <div class="absolute inset-0 rounded-xl bg-gradient-to-b from-white/60 to-transparent dark:from-white/5 pointer-events-none"></div>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-ink/80 group-hover:text-accent transition-colors">
                <circle cx="12" cy="12" r="10"/><path d="M14.83 14.83a4 4 0 1 1 0-5.66"/>
              </svg>
            </div>
            <h2 class="text-[18px] font-semibold text-ink mb-1.5 tracking-[-0.01em]">{t('home.watermark_title')}</h2>
            <p class="text-[14px] text-body leading-relaxed">{t('home.watermark_desc')}</p>
          </div>
          <div class="mt-6 flex items-center gap-1.5 text-[13px] font-medium text-accent">
            {t('home.watermark_title')}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-0.5 transition-transform" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>
        </a>

      </div>
    </div>
    </section>

    <!-- ── Trust strip ──────────────────────────────────────────── -->
    <section class="border-t border-hairline bg-canvas-elevated">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
        <dl class="grid sm:grid-cols-3 gap-6 sm:gap-8 text-[13px]">
          <div class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent mt-0.5 shrink-0" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
            <div>
              <dt class="font-semibold text-ink">Private by design</dt>
              <dd class="text-body mt-0.5">Images never leave your device. Processing happens entirely in your browser.</dd>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent mt-0.5 shrink-0" aria-hidden="true"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            <div>
              <dt class="font-semibold text-ink">No account required</dt>
              <dd class="text-body mt-0.5">Free to use. No sign-up, no email, no payment information.</dd>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent mt-0.5 shrink-0" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
            <div>
              <dt class="font-semibold text-ink">Multiple files at once</dt>
              <dd class="text-body mt-0.5">Select up to 50 images per session. Results download as a single ZIP.</dd>
            </div>
          </div>
        </dl>
      </div>
    </section>

  </main>

  <SeoContent
    heading="Free In-Browser Image Optimization and Editing Suite"
    paragraphs={[
      "FixMyImage is a privacy-first collection of free online photo tools engineered to handle everyday image tasks with speed and precision. Whether you are managing product listings for an online store, preparing document attachments for government or academic portals, or tuning graphics for social media, FixMyImage provides specialized utilities right inside your browser without accounts, fees, or watermarks.",
      "Unlike traditional cloud-based utilities that require transferring your photos across the web to third-party servers, FixMyImage operates entirely client-side. By leveraging modern browser APIs and local memory rendering, all compression, resizing, format conversion, and watermarking happen directly on your device. Your personal files remain completely private, and tasks complete instantly without server upload queues."
    ]}
    sections={[
      {
        title: "Supported Image Tasks",
        paragraphs: [
          "Image Compression: Shrink large JPG, PNG, and WebP files with fine-grained quality controls or target specific file sizes such as 20KB, 50KB, 100KB, or 1MB for portal forms and email attachments.",
          "Image Resizing: Resize individual photos or entire batches by exact pixel dimensions, percentage scaling, or physical centimeters with calibrated print DPI.",
          "Format Conversion: Seamlessly switch between JPG, PNG, WebP, and AVIF formats while preserving image quality, transparency channels, and color fidelity.",
          "Watermarking: Stamp custom text notices or brand logos onto images with full control over opacity, positioning, and rotation to protect your creative work."
        ]
      },
      {
        title: "Who Is FixMyImage For?",
        paragraphs: [
          "FixMyImage is built for creators, photographers, e-commerce sellers, web developers, and everyday users who need dependable image processing without installing heavyweight software or handing over personal data. From quick passport photo prep to mass product image optimization, every tool is designed to deliver immediate results in a clean, ad-free workflow."
        ]
      }
    ]}
    faqs={homeFaqs}
    relatedHeading="Explore Popular Tools"
    relatedLinks={homeRelatedLinks}
  />

  <Footer />
</BaseLayout>
