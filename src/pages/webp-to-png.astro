---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConvertDropzone from '../components/ConvertDropzone.astro';
import SeoContent from '../components/SeoContent.astro';
import { getFaqsForRoute } from '../data/curatedFaqs';

const title = "WebP to PNG Converter – Convert WebP to PNG Online Free | FixMyImage";
const desc = "Convert WebP images to PNG format online for free. Preserve alpha transparency and lossless quality directly in your browser.";
const canonicalUrl = "https://fixmyimage.app/webp-to-png";

const faqs = getFaqsForRoute('/webp-to-png');

const relatedLinks = [
  { label: "WebP to JPG", href: "/webp-to-jpg" },
  { label: "JPG to PNG", href: "/jpg-to-png" },
  { label: "AVIF to PNG", href: "/avif-to-png" },
  { label: "PNG to JPG", href: "/png-to-jpg" },
  { label: "Image Resizer", href: "/resize-image" }
];
---

<BaseLayout title={title} description={desc} canonical={canonicalUrl}>
  <Header />
  <main class="flex-grow flex flex-col items-center justify-center px-4 py-12 md:py-16 bg-canvas min-h-[calc(100vh-72px)]">
    <div class="w-full max-w-4xl mx-auto">
      <ConvertDropzone 
        h1="Convert WebP to PNG"
        subtitle="Convert WebP images to PNG format online for free."
        initialInputFormat="webp"
        initialOutputFormat="png"
      />
    </div>
  </main>

  <SeoContent
    heading="Lossless WebP to PNG Conversion with Transparency"
    paragraphs={[
      "Convert WebP graphics into high-fidelity PNG files with full transparency support. While WebP is widely used across modern websites, many design applications and offline tools still require PNG for optimal asset editing and transparency handling. For smaller file sizes without transparency, try converting <a href='/webp-to-jpg/' class='text-accent hover:underline'>WebP to JPG</a>.",
      "FixMyImage's <a href='/convert-image/' class='text-accent hover:underline'>image converter</a> processes your images directly in your browser without uploading to external servers. Convert logos, screenshots, and artwork to PNG with pristine clarity. You can also reverse standard photos easily with our <a href='/jpg-to-png/' class='text-accent hover:underline'>JPG to PNG</a> utility."
    ]}
    faqs={faqs}
    relatedHeading="Related Image Converters"
    relatedLinks={relatedLinks}
  />

  <Footer />
</BaseLayout>
