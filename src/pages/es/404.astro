---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const tools = [
  {
    title: "Comprimir Imagen",
    desc: "Reduce el peso de archivos JPG, PNG y WebP",
    href: "/es/compress-image",
    icon: `<path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/><path d="M12 12v9"/><path d="m16 16-4-4-4 4"/>`
  },
  {
    title: "Redimensionar Imagen",
    desc: "Cambia dimensiones en píxeles o porcentaje",
    href: "/es/resize-image",
    icon: `<path d="M21 3H3v18h18V3z"/><path d="M21 9H3"/><path d="M9 21V9"/>`
  },
  {
    title: "Convertir Imagen",
    desc: "Transforma entre formatos WebP, JPG, PNG y AVIF",
    href: "/es/convert-image",
    icon: `<path d="M8 3 4 7l4 4"/><path d="M4 7h16"/><path d="m16 21 4-4-4-4"/><path d="M20 17H4"/>`
  },
  {
    title: "Marca de Agua",
    desc: "Agrega texto personalizado o logos a tus fotos",
    href: "/es/watermark-image",
    icon: `<circle cx="12" cy="12" r="10"/><path d="M14.83 14.83a4 4 0 1 1 0-5.66"/>`
  }
];
---

<BaseLayout
  title="404 – Página no encontrada | FixMyImage"
  description="Lo sentimos, la página que buscas no existe en FixMyImage. Explora nuestras herramientas gratuitas de compresión, cambio de tamaño y conversión."
  noindex={true}
>
  <Header />
  
  <main class="flex-grow flex flex-col items-center justify-center px-4 sm:px-6 lg:px-8 py-16 md:py-24 text-ink">
    <div class="text-center max-w-2xl w-full mx-auto">
      
      <div class="inline-flex items-center justify-center px-4 py-1.5 rounded-full bg-accent/10 border border-accent/20 text-accent font-mono font-bold text-sm tracking-widest uppercase mb-6">
        Error 404
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-ink mb-4">
        Página No Encontrada
      </h1>
      
      <p class="text-base sm:text-lg text-body mb-8 max-w-lg mx-auto leading-relaxed">
        El enlace que has seguido puede estar roto o la página ha sido trasladada o eliminada. Explora nuestras herramientas a continuación.
      </p>
      
      <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 mb-12">
        <a
          href="/es"
          class="btn-primary inline-flex items-center justify-center px-6 py-3 text-base font-semibold shadow-md shadow-accent/20"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
          Volver al Inicio
        </a>
        <a
          href="/es/contact"
          class="inline-flex items-center justify-center px-5 py-3 text-base font-medium rounded-lg border border-hairline bg-canvas-elevated hover:bg-hairline-soft transition-colors text-body hover:text-ink"
        >
          Contactar Soporte
        </a>
      </div>

      <div class="bg-canvas-elevated border border-hairline rounded-2xl p-6 sm:p-8 text-left shadow-sm">
        <h2 class="text-xs font-bold text-mute uppercase tracking-widest mb-4">
          Herramientas Populares:
        </h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          {tools.map(tool => (
            <a
              href={tool.href}
              class="flex items-start gap-3.5 p-3.5 rounded-xl border border-hairline bg-canvas hover:border-ink/30 transition-all group"
            >
              <div class="w-10 h-10 rounded-lg bg-canvas-elevated border border-hairline text-accent flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={tool.icon} />
              </div>
              <div class="min-w-0">
                <div class="text-[15px] font-bold text-ink group-hover:text-accent transition-colors flex items-center justify-between">
                  {tool.title}
                  <span class="text-mute font-normal text-xs">&rarr;</span>
                </div>
                <p class="text-[13px] text-body truncate mt-0.5">
                  {tool.desc}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer />
</BaseLayout>
