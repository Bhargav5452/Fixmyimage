---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConvertDropzone from '../components/ConvertDropzone.astro';
import SeoContent from '../components/SeoContent.astro';
import { getFaqsForRoute } from '../data/curatedFaqs';

const title = "AVIF to JPG Converter – Convert AVIF to JPG Online Free | FixMyImage";
const desc = "Convert AVIF images to JPG format online for free. Transform next-gen AVIF files into universally supported JPEG photos directly in your browser.";
const canonicalUrl = "https://fixmyimage.app/avif-to-jpg";

const faqs = getFaqsForRoute('/avif-to-jpg');

const relatedLinks = [
  { label: "AVIF to PNG", href: "/avif-to-png" },
  { label: "WebP to JPG", href: "/webp-to-jpg" },
  { label: "JPG to PNG", href: "/jpg-to-png" },
  { label: "PNG to JPG", href: "/png-to-jpg" },
  { label: "Compress Image", href: "/compress-image" }
];
---

<BaseLayout title={title} description={desc} canonical={canonicalUrl}>
  <Header />
  <main class="flex-grow flex flex-col items-center justify-center px-4 py-12 md:py-16 bg-canvas min-h-[calc(100vh-72px)]">
    <div class="w-full max-w-4xl mx-auto">
      <ConvertDropzone 
        h1="Convert AVIF to JPG"
        subtitle="Convert AVIF images to JPG format online for free."
        initialInputFormat="avif"
        initialOutputFormat="jpeg"
      />
    </div>
  </main>

  <SeoContent
    heading="Convert Modern AVIF to Universally Compatible JPG"
    paragraphs={[
      "AVIF delivers incredible compression for modern websites, but opening `.avif` files in standard photo viewers, older operating systems, or sharing them on social platforms often fails. Converting AVIF to JPG solves this compatibility hurdle instantly.",
      "FixMyImage converts AVIF images into standard JPEG files right inside your browser. No files are uploaded to remote servers, giving you fast batch conversions with total privacy."
    ]}
    faqs={faqs}
    relatedHeading="Related Image Converters"
    relatedLinks={relatedLinks}
  />

  <Footer />
</BaseLayout>
