---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConvertDropzone from '../components/ConvertDropzone.astro';
import SeoContent from '../components/SeoContent.astro';
import { getFaqsForRoute } from '../data/curatedFaqs';

const title = "AVIF to JPG Converter – Free, No Upload | FixMyImage";
const desc = "Convert AVIF to JPG free in your browser. Nothing is uploaded and no sign-up is needed. Transparent areas are filled with white.";
const canonicalUrl = "https://fixmyimage.app/avif-to-jpg/";

const answerBlock = "AVIF is a modern image format with strong compression, but many photo viewers, older operating systems and upload forms cannot open it. To convert an AVIF file to JPG, add the file to FixMyImage, choose JPG as the output and download the result. The conversion runs in your browser, so the image is never uploaded. JPG cannot store transparency, so any transparent areas are filled with white. If you need to keep transparency, convert to PNG instead. The JPG will usually be larger than the original AVIF, because AVIF compresses more efficiently, although the picture looks the same on screen. If a file fails to convert, the browser could not decode it, which can happen with damaged files or less common AVIF features. FixMyImage is free and needs no sign-up.";

const faqs = [
  ...getFaqsForRoute('/avif-to-jpg'),
  {
    q: "Will the JPG be bigger than my AVIF file?",
    a: "Usually, yes. AVIF compresses more efficiently than JPG, so the same picture takes more space as a JPG even though it looks the same on screen."
  },
  {
    q: "Can I convert an animated AVIF?",
    a: "JPG holds a single image, so only one frame is saved. If you need to keep the animation, convert to a format that supports it instead."
  }
];

const relatedLinks = [
  { label: "AVIF to PNG", href: "/avif-to-png/" },
  { label: "WebP to JPG", href: "/webp-to-jpg/" },
  { label: "JPG to PNG", href: "/jpg-to-png/" },
  { label: "PNG to JPG", href: "/png-to-jpg/" },
  { label: "Compress Image", href: "/compress-image/" }
];
---

<BaseLayout title={title} description={desc} canonical={canonicalUrl} faqs={faqs}>
  <Header />
  <main class="flex-grow flex flex-col items-center justify-start px-4 pt-8 md:pt-12 pb-12 md:pb-16 bg-canvas min-h-[calc(100vh-72px)]">
    <div class="w-full max-w-[960px] mx-auto">
      <ConvertDropzone 
        h1="Convert AVIF to JPG"
        subtitle="Convert AVIF images to JPG format online for free."
        initialInputFormat="avif"
        initialOutputFormat="jpeg"
      />
    </div>
  </main>

  <SeoContent
    answerBlock={answerBlock}
    heading="Convert Modern AVIF to Universally Compatible JPG"
    paragraphs={[
      "AVIF delivers incredible compression for modern websites, but opening `.avif` files in standard photo viewers, older operating systems, or sharing them on social platforms often fails. Converting AVIF to JPG solves this compatibility hurdle instantly. For transparency support, you might prefer converting <a href='/avif-to-png/' class='text-accent hover:underline'>AVIF to PNG</a> instead.",
      "FixMyImage's <a href='/convert-image/' class='text-accent hover:underline'>image converter</a> transforms AVIF images into standard JPEG files right inside your browser. No files are uploaded to remote servers, giving you fast batch conversions with total privacy. This works similarly to our popular <a href='/webp-to-jpg/' class='text-accent hover:underline'>WebP to JPG</a> conversion tool for other next-gen web formats."
    ]}
    faqs={faqs}
    relatedHeading="Related Image Converters"
    relatedLinks={relatedLinks}
  />

  <Footer />
</BaseLayout>
