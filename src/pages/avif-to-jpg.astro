---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConvertDropzone from '../components/ConvertDropzone.astro';

const title = "AVIF to JPG Converter – Convert AVIF to JPG Online | FixMyImage";
const desc = "Convert AVIF images to JPG format online for free.";
---

<BaseLayout title={title} description={desc}>
  <Header />
  <main class="flex-grow flex flex-col items-center px-4 py-12 md:py-20 bg-canvas">
    <div class="w-full max-w-4xl mx-auto">
      <ConvertDropzone 
        h1="Convert AVIF to JPG"
        subtitle="Convert AVIF images to JPG format online for free."
        initialInputFormat="avif"
        initialOutputFormat="jpeg"
      />
    </div>
  </main>
  <Footer />
</BaseLayout>
